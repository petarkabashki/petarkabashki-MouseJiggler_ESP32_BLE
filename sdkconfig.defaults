# ESP-IDF build defaults. The Arduino environments ignore this file.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_huge.csv"

# The C3 talks to the host over its built-in USB Serial/JTAG, which is what
# src/port_idf.c drives directly.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The Forth REPL task does its own yielding; the interpreter can legitimately
# sit in a long word, and a panic there would be worse than a slow prompt.
CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# BLE HID device. Bluedroid rather than NimBLE: it is what the Arduino build
# uses, so pairing behaviour and the report map carry over unchanged.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
